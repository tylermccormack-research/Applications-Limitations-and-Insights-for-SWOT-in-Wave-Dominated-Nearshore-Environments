function [dataStructOut]=processSWOT_L1_LR_INTF_noInterp(inputPath)
    % processSWOTFiles Processes SWOT NetCDF files in the given directory
    % 
    % INPUT:
    %   inputPath - Path to the folder containing SWOT NetCDF files.
    %
    % OUTPUT:
    %   Saves a MAT file containing the processed data structure.

    % Disable warnings
    warning('off', 'all'); % Turn off all warnings

    % Validate input path
    if ~isfolder(inputPath)
        error('The specified folder does not exist: %s', inputPath);
    end

    % Delete any files in path that don't contain "_354_" or "_063_"
    deleteFilesNotContainingPatterns(inputPath);

    % Get a list of NetCDF files in the directory
    fileList = dir(fullfile(inputPath, '*.nc'));

    % Check if files are found
    if isempty(fileList)
        error('No NetCDF files found in the specified folder: %s', inputPath);
    end

    % Load FRF water level sensor locations
    load('waterLevel_frfX.mat');
    load('waterLevel_frfY.mat');

    % Initialize the structure
    dataStruct = struct();

    % Loop through each file
    for i = 1%:length(fileList)
        % Get file name
        fname = fileList(i).name;
        fullFilePath = fullfile(fileList(i).folder, fname);

        % Print the name of the file being processed
        disp(['Processing file: ', fname]);

        % Extract the digits before the date and the date itself
        pattern = '(\d{3}_\d{3})_(\d{8})'; % Matches "001_354_20230802"
        match = regexp(fname, pattern, 'tokens');
        if isempty(match)
            warning('No valid pattern found in file name: %s', fname);
            continue;
        end
        prefix = match{1}{1}; % The "001_354" part
        date = match{1}{2};   % The "20230802" part
        fieldName = ['L1B_LR_INTF_' prefix '_' date]; % Combine into "001_354_20230802"


        

        % Map to pixel cloud locations
         % [Xpix, Ypix, Interferogram, AngleCorr, GeomCorr, NoiseCorr] = getIntfVars( fname);
         %
         parts = split(fname, '_');
         track_number = parts{6};

         if strcmp(track_number, '354')
             tmpRefLat=ncread(fname,'left/reference_latitude');
             tmpRefLon=ncread(fname, 'left/reference_longitude');
             tmpIntf=ncread(fname, 'left/interferogram');
             tmpAngCorr = ncread(fname, 'left/angular_correlation');
             tmpGeomCorr = ncread(fname, 'left/geometric_correlation');
             tmpNoiseCorr = ncread(fname, 'left/noise_correlation');
             tmpReference_latitude=ncread(fname, 'left/reference_latitude');
             tmpReference_longitude=ncread(fname, 'left/reference_longitude');
             tmpReference_location=ncread(fname, 'left/reference_location'); 
             tmpDoppler_centroid=ncread(fname, 'left/doppler_centroid');

             % TVP
             tmpTvpX=ncread(fname, 'tvp_left/x');
             tmpTvpY=ncread(fname, 'tvp_left/y');
             tmpTvpZ=ncread(fname, 'tvp_left/z');
             tmpPlus_y_antenna_x=ncread(fname, 'tvp_left/plus_y_antenna_x');
             tmpPlus_y_antenna_y=ncread(fname, 'tvp_left/plus_y_antenna_y');
             tmpPlus_y_antenna_z=ncread(fname, 'tvp_left/plus_y_antenna_z');
             tmpMinus_y_antenna_x=ncread(fname, 'tvp_left/minus_y_antenna_x');
             tmpMinus_y_antenna_y=ncread(fname, 'tvp_left/minus_y_antenna_y');
             tmpMinus_y_antenna_z=ncread(fname, 'tvp_left/minus_y_antenna_z'); 
             tmpTvpVX=ncread(fname, 'tvp_left/vx');
             tmpTvpVY=ncread(fname, 'tvp_left/vy');
             tmpTvpVZ=ncread(fname, 'tvp_left/vz');  
               
             
         else
             tmpRefLat=ncread(fname,'right/reference_latitude');
             tmpRefLon=ncread(fname, 'right/reference_longitude');
             tmpIntf=ncread(fname, 'right/interferogram');
             tmpAngCorr = ncread(fname, 'right/angular_correlation');
             tmpGeomCorr = ncread(fname, 'right/geometric_correlation');
             tmpNoiseCorr = ncread(fname, 'right/noise_correlation');
             tmpReference_latitude=ncread(fname, 'right/reference_latitude');
             tmpReference_longitude=ncread(fname, 'right/reference_longitude');
             tmpReference_location=ncread(fname, 'right/reference_location'); 
             tmpDoppler_centroid=ncread(fname, 'right/doppler_centroid');

             % TVP
             tmpTvpX=ncread(fname, 'tvp_right/x');
             tmpTvpY=ncread(fname, 'tvp_right/y');
             tmpTvpZ=ncread(fname, 'tvp_right/z');
             tmpPlus_y_antenna_x=ncread(fname, 'tvp_right/plus_y_antenna_x');
             tmpPlus_y_antenna_y=ncread(fname, 'tvp_right/plus_y_antenna_y');
             tmpPlus_y_antenna_z=ncread(fname, 'tvp_right/plus_y_antenna_z');
             tmpMinus_y_antenna_x=ncread(fname, 'tvp_right/minus_y_antenna_x');
             tmpMinus_y_antenna_y=ncread(fname, 'tvp_right/minus_y_antenna_y');
             tmpMinus_y_antenna_z=ncread(fname, 'tvp_right/minus_y_antenna_z'); 
             tmpTvpVX=ncread(fname, 'tvp_right/vx');
             tmpTvpVY=ncread(fname, 'tvp_right/vy');
             tmpTvpVZ=ncread(fname, 'tvp_right/vz');  


             % TVP
          
         end
         wavelength=0.008385803020979;


         % Convert from 0-360 longitude to -180 to 180
         tmpRefLon = rem((tmpRefLon + 180), 360) - 180;

         % % Geographic location mask
         minLat = 36.15;
         maxLat = 36.22;
         minLon = -75.765;
         maxLon = -75.69;
         %
         locationMask = (tmpRefLat >= minLat) & (tmpRefLat <= maxLat) & ...
             (tmpRefLon >= minLon) & (tmpRefLon <= maxLon);

         % Combine both masks
         combinedMask = locationMask;

         % Convert to FRF Coordinates
         [~, ~, ~, ~, Ypix, Xpix] = frfCoord_bigArea(tmpRefLon(combinedMask), tmpRefLat(combinedMask));
        %

        % Calculate d h / d phi
        tmpTvpX_expanded=repmat(reshape(tmpTvpX, [1, 82087, 1]), 240, 1, 9);
        tmpTvpY_expanded=repmat(reshape(tmpTvpY, [1, 82087, 1]), 240, 1, 9);
        tmpTvpZ_expanded=repmat(reshape(tmpTvpZ, [1, 82087, 1]), 240, 1, 9);
        
        tmpPlus_y_antenna_x_expanded=repmat(reshape(tmpPlus_y_antenna_x, [1, 82087, 1]), 240, 1, 9);
        tmpPlus_y_antenna_y_expanded=repmat(reshape(tmpPlus_y_antenna_y, [1, 82087, 1]), 240, 1, 9);
        tmpPlus_y_antenna_z_expanded=repmat(reshape(tmpPlus_y_antenna_z, [1, 82087, 1]), 240, 1, 9);

        tmpMinus_y_antenna_x_expanded=repmat(reshape(tmpMinus_y_antenna_x, [1, 82087, 1]), 240, 1, 9);
        tmpMinus_y_antenna_y_expanded=repmat(reshape(tmpMinus_y_antenna_y, [1, 82087, 1]), 240, 1, 9);
        tmpMinus_y_antenna_z_expanded=repmat(reshape(tmpMinus_y_antenna_z, [1, 82087, 1]), 240, 1, 9);

        tmpTvpVX_expanded = repmat(reshape(tmpTvpVX, [1, 82087, 1]), 240, 1, 9);
        tmpTvpVY_expanded = repmat(reshape(tmpTvpVY, [1, 82087, 1]), 240, 1, 9);
        tmpTvpVZ_expanded = repmat(reshape(tmpTvpVZ, [1, 82087, 1]), 240, 1, 9);


        tmpX = tmpReference_location(1, :, :, :);
        tmpY = tmpReference_location(2, :, :, :);
        tmpZ = tmpReference_location(3, :, :, :);

        S=[tmpTvpX_expanded(combinedMask), tmpTvpY_expanded(combinedMask), tmpTvpZ_expanded(combinedMask)];
        S1=[tmpPlus_y_antenna_x_expanded(combinedMask), tmpPlus_y_antenna_y_expanded(combinedMask), tmpPlus_y_antenna_z_expanded(combinedMask)];
        S2=[tmpMinus_y_antenna_x_expanded(combinedMask), tmpMinus_y_antenna_y_expanded(combinedMask), tmpMinus_y_antenna_z_expanded(combinedMask)];
        V=[tmpTvpVX_expanded(combinedMask), tmpTvpVY_expanded(combinedMask), tmpTvpVZ_expanded(combinedMask)];
        p_ref=[tmpX(combinedMask), tmpY(combinedMask), tmpZ(combinedMask)];
        lambda=wavelength;
        phi_prime=0.01; % [radians]
        intfIn=(tmpIntf(1,combinedMask) + 1i*tmpIntf(2,combinedMask))';
        dh_dphi = swot_height_sensitivity(S1, S2, S, V, p_ref, lambda, tmpIntf(:,combinedMask), phi_prime);

         % Store results in the structure under the unique key
        dataStructOut.(fieldName) = struct( ...
            'FRF_X', Xpix, ...
            'FRF_Y', Ypix, ...
            'Interferogram', tmpIntf(:,combinedMask), ...
            'AngleCorrelation_interp', tmpAngCorr(combinedMask), ...
            'GeomCorrection_interp',tmpGeomCorr(combinedMask), ...
            'NoiseCorrelation', tmpNoiseCorr(combinedMask), ...
            'Reference_latitude', tmpReference_latitude(combinedMask), ...
            'Reference_longitude', tmpReference_longitude(combinedMask), ...
            'Reference_location', tmpReference_location(combinedMask), ...
            'dh_dphi', dh_dphi ...
           );


    % Save the structure to a MAT file
    save(fullfile('D:\SWOT\Data\SWOTdata', 'dataStruct_LR_L1B_INTF_noInterp.mat'), 'dataStructOut');

    end
        disp('Processing complete. Data saved.');

end

            % 'TvpX', tmpTvpX(combinedMask(:,:,1)'), ...
            % 'TvpY', tmpTvpY(combinedMask), ...
            % 'TvpZ', tmpTvpZ(combinedMask), ...
            % 'Plus_y_antenna_x', tmpPlus_y_antenna_x(combinedMask), ...
            % 'Plus_y_antenna_y', tmpPlus_y_antenna_y(combinedMask), ...
            % 'Plus_y_antenna_z', tmpPlus_y_antenna_z(combinedMask), ...
            % 'Minus_y_antenna_x', tmpMinus_y_antenna_x(combinedMask), ...
            % 'Minus_y_antenna_y', tmpMinus_y_antenna_y(combinedMask), ...
            % 'Minus_y_antenna_z', tmpMinus_y_antenna_z(combinedMask), ...
            % 'TvpVX', tmpTvpVX(combinedMask), ...
            % 'TvpVY', tmpTvpVY(combinedMask), ...
            % 'TvpVZ', tmpTvpVZ(combinedMask) ...